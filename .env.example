# Copie para .env (`make install` faz isso) e ajuste. Nunca versione o .env.
# CHANGEME marca um segredo: `make secret` gera os segredos locais, e `make check-env`
# impede a subida de um lab enquanto um segredo exigido por ele estiver como CHANGEME.

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Segredo: senha do administrador local do Grafana. `make secret` gera um valor aleatório.
GRAFANA_ADMIN_PASSWORD=CHANGEME

# --- Stack de observabilidade (portas publicadas em 127.0.0.1) ---
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
LOKI_PORT=3100
LOKI_RETENTION_PERIOD=72h

# --- OpenTelemetry e logs ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SDK_DISABLED=false
LOG_LEVEL=INFO

# --- Provedor de LLM ---
# Valores aceitos: fake (padrão, sem custo e sem chave), anthropic, openai ou gemini.
LLM_PROVIDER=fake
# Modelo usado pelos provedores reais. Obrigatório quando LLM_PROVIDER não for fake.
LLM_MODEL=
# Segredo opcional: chave da API da Anthropic, usada só com LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=CHANGEME
# Segredo opcional: chave da API da OpenAI, usada só com LLM_PROVIDER=openai.
OPENAI_API_KEY=CHANGEME
# Segredo opcional: chave da API do Gemini, usada só com LLM_PROVIDER=gemini.
GEMINI_API_KEY=CHANGEME

# --- Serviços dos labs ---
# Porta publicada pelo serviço principal do lab, para uso com o MCP Inspector.
LAB_SERVICE_PORT=8000
# Segredo: senha local do PostgreSQL dos labs 07, 08, 09 e 15.
POSTGRES_PASSWORD=CHANGEME
# Segredo: senha do administrador local do Keycloak no lab 11.
KEYCLOAK_ADMIN_PASSWORD=CHANGEME
# Segredo: senha do usuário de demonstração do Keycloak no lab 11.
KEYCLOAK_DEMO_PASSWORD=CHANGEME
# Segredo: token que a borda injeta nas chamadas ao backend no lab 12.
MCP_BEARER_TOKEN=CHANGEME
# Segredo opcional: token do GitHub, com o mínimo de permissões, para o GitHub MCP do lab 07.
GITHUB_TOKEN=CHANGEME
